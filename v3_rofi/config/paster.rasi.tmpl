/* paster v3 — rofi theme TEMPLATE.
 * bin/toggle.sh renders this to $XDG_RUNTIME_DIR/paster.rasi on every
 * toggle, substituting the __PLACEHOLDER__ values from config.yaml —
 * edit config.yaml, not the rendered file.
 * Layout mirrors v1: tab bar on top, then the filter line, then the list. */

* {
    font:             "monospace __FONT_SIZE__";
    fg:               __FG__;
    background-color: transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    location:         north;
    anchor:           north;
    width:            __WIDTH__%;
    height:           __HEIGHT__%;
    border:           __BORDER__px;
    border-color:     @fg;
    background-color: __BG_RGBA__;
    padding:          4px;
}

mainbox {
    children: [ mode-switcher, inputbar, listview ];
    spacing:  4px;
}

/* Tab bar — blue tabs, the current one bold red, like v1's nav line. */
mode-switcher {
    spacing: 8px;
}
button {
    padding:    2px 10px;
    text-color: #5c9dff;
}
button selected {
    text-color:       #ff5555;
    background-color: rgba ( 255, 255, 255, 8 % );
}

inputbar {
    children: [ prompt, entry ];
    spacing:  8px;
    padding:  2px 4px;
}
prompt {
    text-color: #00afff;
}
entry {
    placeholder:       "type to filter…";
    placeholder-color: rgba ( 216, 222, 233, 35 % );
}

listview {
    scrollbar:    false;
    fixed-height: false;
}
element {
    padding: 2px 6px;
}
element selected {
    background-color: rgba ( 255, 255, 255, 12 % );
}
element-text {
    highlight: bold #00afff;
}
